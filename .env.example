# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Leave empty for demo mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Firebase web app config (console.firebase.google.com > Project settings > Your apps).
# Enable Firebase AI Logic with the Gemini Developer API. Leave empty to use Chrome's built-in model or the offline rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
# Optional: cloud fallback model
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

PORT=8787
VITE_APPCHECK_DEBUG_TOKEN=
VITE_RECAPTCHA_SITE_KEY=
